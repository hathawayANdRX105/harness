#!/usr/bin/env bash
# pre-push gate — 本地轻量守卫：fmt --check + clippy（harn CI lint job 的本地版）。
#
# harn 暂无 rust-specs spec-check（无 xtask workspace，且 rust-specs dylint 需要
# nightly；harn 日常用 stable）。待 rust-specs 接入后再在这里加 spec-check gate。
set -euo pipefail
REPO=$(git rev-parse --show-toplevel 2>/dev/null)
cd "$REPO" || exit 1

echo "== fmt --check =="
cargo fmt --all -- --check

echo "== clippy (workspace, -D warnings) =="
cargo clippy --workspace --all-targets -- -D warnings

echo "✓ pre-push gate passed"
